    "vo": [
      {
        "id": "v01",
        "at": 20,
        "ja": "一本の糸から、物語は始まる。",
        "zh": "故事，从一根线开始。"
      },
      {
        "id": "v02",
        "at": 160,
        "ja": "無数の運命が、交わり、すれ違う。",
        "zh": "无数命运，交会，又错过。"
      },
      {
        "id": "v03",
        "at": 315,
        "ja": "リベイラに、風が吹く。",
        "zh": null
      },
      {
        "id": "v04",
        "at": 415,
        "ja": "異郷に、剣が鳴る。",
        "zh": null
      },
      {
        "id": "v05",
        "at": 515,
        "ja": "女王と、その国。",
        "zh": null
      },
      {
        "id": "v06",
        "at": 615,
        "ja": "薔薇の、復讐の歌。",
        "zh": null
      },
      {
        "id": "v07",
        "at": 712,
        "ja": "四つの道は、やがて一つの運命へ。",
        "zh": "四条路，终将汇成同一个命运。"
      },
      {
        "id": "v08",
        "at": 830,
        "ja": "その旅路を、一冊の手帖に。",
        "zh": "把这段旅程，收进一本手帖。"
      },
      {
        "id": "v09",
        "at": 1030,
        "ja": "誰と出会い、誰を迎えるか。",
        "zh": "与谁相遇，迎谁同行。"
      },
      {
        "id": "v10",
        "at": 1215,
        "ja": "見逃したくない、ひとときも。",
        "zh": "每一段，都不想错过。"
      },
      {
        "id": "v11",
        "at": 1315,
        "ja": "昼も夜も、静かに寄り添う。",
        "zh": "无论昼夜，静静相伴。"
      },
      {
        "id": "v12",
        "at": 1430,
        "ja": "幾万の糸の中から、あなただけの勝利を。",
        "zh": null
      }
