{
  "name": "fe-guide-promo",
  "private": true,
  "description": "Promotional video for the 万缕千丝 战术手帖 site. Separate from the site build; the site still needs no npm.",
  "scripts": {
    "prepare-assets": "node scripts/prepare.mjs",
    "capture": "node scripts/capture.mjs",
    "audio": "python3 audio/synth.py",
    "studio": "remotion studio",
    "animatic": "remotion render Long out/long-animatic.mp4 --scale=0.5 --props='{\"animatic\":true}'",
    "animatic:short": "remotion render Short out/short-animatic.mp4 --scale=0.5 --props='{\"animatic\":true}'",
    "render": "remotion render Long out/long.mp4 && remotion render Short out/short.mp4"
  },
  "dependencies": {
    "@remotion/cli": "4.0.532",
    "@remotion/three": "4.0.532",
    "@react-three/fiber": "^8.17.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.532",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/three": "0.169.0",
    "typescript": "^5.6.3"
  }
}
